#!/usr/bin/env php
<?php

if (!extension_loaded('dom') || !extension_loaded('mbstring')) {
    $iniScan = '/etc/php/8.4/cli/conf.d:' . __DIR__ . '/php_conf';
    putenv('PHP_INI_SCAN_DIR=' . $iniScan);
    $_ENV['PHP_INI_SCAN_DIR'] = $iniScan;
    $args = array_map('escapeshellarg', $argv);
    passthru(PHP_BINARY . ' ' . implode(' ', $args), $code);
    exit($code);
}

// Ensure MariaDB daemon is active on /tmp/mysql.sock
if (!file_exists('/tmp/mysql.sock')) {
    exec("mariadbd --datadir=/tmp/mariadb_data --socket=/tmp/mysql.sock --port=3307 --pid-file=/tmp/mariadb.pid >/dev/null 2>&1 &");
    for ($i = 0; $i < 10; $i++) {
        if (file_exists('/tmp/mysql.sock')) break;
        usleep(200000);
    }
}

use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
$status = (require_once __DIR__.'/bootstrap/app.php')
    ->handleCommand(new ArgvInput);

exit($status);
